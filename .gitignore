# ---- Python ----
backend/.venv/
__pycache__/
*.pyc
*.pyo

# ---- Node ----
frontend/node_modules/
frontend/dist/

# ---- 环境与敏感信息（绝不入仓）----
.env
*.env
!.env.example
# assets/ 下的知识库与输入包允许入仓，但其中任何 .env 一律排除
# 已实测：assets/kb/02_千问API与env配置/.env 命中本文件第 13 行 `*.env` 规则
assets/**/.env
assets/**/*.env

# ---- 本地数据（SQLite 数据库，含用户数据）----
backend/data/
*.db

# ---- 系统 / 工具 ----
.DS_Store
.workbuddy/

# ---- 运行时输出 ----
results/
logs/
assets/**/results/
assets/**/logs/

